import os

configfile: 'config/config.yaml'

FOLDER = os.path.abspath('.')
bgee_ortho = f"{FOLDER}/data/gene_expression_orthogroups_15_2"
datasets = [i.replace(".csv","") for i in os.listdir(f"{bgee_ortho}/log2TPM") if
            not i.startswith(".") and os.path.isfile(f"{bgee_ortho}/log2TPM/{i}")]
print(datasets)
traits = config["TRAITS"]
oma_data = config["OMA_DATA"]
methods = config["METHODS"]
clades = config["CLADES"]
orthologs_path = f"{FOLDER}/data/gene_orthologies/one2one_orthogroups_{oma_data}_mammals.csv"

wildcard_constraints:
    # constrain to only alphanumeric characters and underscore
    trait=r"[a-zA-Z0-9]+",method=r"[a-zA-Z]+",clade=r"[a-zA-Z]+"

rule all:
    input:
        expand(f"{FOLDER}/results/{{trait}}_{{clade}}/corr_dataset_{{method}}_{{trait}}.png",method=methods,trait=traits,clade=clades),
        expand(f"{FOLDER}/results/{{trait}}_{{clade}}/corr_switch_{{method}}_{{trait}}.pdf",method=methods,trait=traits,clade=clades),
        expand(f"{FOLDER}/results/{{trait}}_{{clade}}/trait_sequence_corr_{{method}}_{{trait}}.pdf",method=methods, trait=traits,clade=clades),
        expand(f"{FOLDER}/results/{{trait}}_{{clade}}/trait_cross_corr_{{organ}}_{{method}}_{{trait}}.pdf",method=methods, trait=traits, clade=clades, organ=["liver","nucleus"]),
        expand(f"{FOLDER}/results/{{trait}}_{{clade}}/merged_boxplot_{{trait}}.pdf",trait=traits,clade=clades),
        expand(f"{FOLDER}/results/{{trait}}_{{clade}}/corr_method_{{trait}}.png",trait=traits,clade=clades),
        expand(f"{FOLDER}/results/{{trait}}_corr_clade_{{method}}.pdf",method=methods,trait=traits)

rule plot_boxplots:
    input:
        script=f"{FOLDER}/scripts/plot_boxplots.py",
        tsv_traits=expand(f"{bgee_ortho}/{{{{trait}}}}/{{dataset}}.csv",dataset=datasets),
        tsv_Bayes=f"{FOLDER}/data_merged/{{trait}}_{{clade}}/merge_Bayes.tsv",
        input_orthogroups=orthologs_path
    output:
        plot=f"{FOLDER}/results/{{trait}}_{{clade}}/merged_boxplot_{{trait}}.pdf"
    shell:
        'python3 {input.script} --input_orthogroups {input.input_orthogroups} --tsv_traits {input.tsv_traits} --tsv_Bayes {input.tsv_Bayes} --output {output.plot}'

rule plot_dataset_corr:
    input:
        script=f"{FOLDER}/scripts/plot_dataset_corr.py",
        tsv_results=f"{FOLDER}/data_merged/{{trait}}_{{clade}}/merge_{{method}}.tsv"
    output:
        plot=f"{FOLDER}/results/{{trait}}_{{clade}}/corr_dataset_{{method}}_{{trait}}.png"
    shell:
        'python3 {input.script} --input {input.tsv_results} --output {output.plot}'

rule plot_method_corr:
    input:
        script=f"{FOLDER}/scripts/plot_method_corr.py",
        tsv_results=expand(f"{FOLDER}/data_merged/{{{{trait}}}}_{{{{clade}}}}/merge_{{method}}.tsv",method=methods)
    output:
        plot=f"{FOLDER}/results/{{trait}}_{{clade}}/corr_method_{{trait}}.png"
    shell:
        'python3 {input.script} --input {input.tsv_results} --output {output.plot}'

rule trait_sequence_corr:
    input:
        script=f"{FOLDER}/scripts/trait_sequence_corr.py",
        tsv_rho=f"{FOLDER}/data_merged/{{trait}}_{{clade}}/merge_{{method}}.tsv",
        gene_table=f"{FOLDER}/data/adaptation/GeneTable.tsv"
    output:
        plot=f"{FOLDER}/results/{{trait}}_{{clade}}/trait_sequence_corr_{{method}}_{{trait}}.pdf"
    shell:
        'python3 {input.script} --input {input.tsv_rho} --gene_table {input.gene_table} --output {output.plot}'

rule trait_cross_corr:
    input:
        script=f"{FOLDER}/scripts/trait_cross_corr.py",
        tsv_rho=f"{FOLDER}/data_merged/{{trait}}_{{clade}}/merge_{{method}}.tsv",
        gene_table=f"{FOLDER}/data/adaptation/GeneTable.tsv",
        cross_table=f"{FOLDER}/data/genetic_cross/mouse_{{organ}}.csv"
    output:
        plot=f"{FOLDER}/results/{{trait}}_{{clade}}/trait_cross_corr_{{organ}}_{{method}}_{{trait}}.pdf"
    shell:
        'python3 {input.script} --input {input.tsv_rho} --gene_table {input.gene_table} --cross_table {input.cross_table} --output {output.plot}'

rule plot_switch_corr:
    input:
        script=f"{FOLDER}/scripts/plot_switch_corr.py",
        tsv_results=f"{FOLDER}/data_merged/{{trait}}_{{clade}}/merge_{{method}}.tsv",
        tsv_RevBayes=f"{FOLDER}/data_merged/{{trait}}_{{clade}}/switch_RevBayes.tsv"
    output:
        plot=f"{FOLDER}/results/{{trait}}_{{clade}}/corr_switch_{{method}}_{{trait}}.pdf"
    shell:
        'python3 {input.script} --input_ratio {input.tsv_results} --input_switch {input.tsv_RevBayes} --output {output.plot}'

rule plot_clade_corr:
    input:
        script=f"{FOLDER}/scripts/plot_clade_corr.py",
        tsv_results=expand(f"{FOLDER}/data_merged/{{{{trait}}}}_{{clade}}/merge_{{{{method}}}}.tsv",clade=clades)
    output:
        plot=f"{FOLDER}/results/{{trait}}_corr_clade_{{method}}.pdf"
    shell:
        'python3 {input.script} --input {input.tsv_results} --output {output.plot}'
