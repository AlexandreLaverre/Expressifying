import os

FOLDER = os.path.abspath('.')
BURN_IN, UNTIL = 1000, 2000

datasets = ['cerebellum', 'kidney', 'liver', 'testis']
traits = ['logTPM', 'score']


rule all:
    input:
        expand(f"{FOLDER}/results/{{trait}}/merged_boxplot_{{trait}}.pdf",trait=traits),
        expand(f"{FOLDER}/results/{{trait}}/corr_scatter_{{method}}_{{trait}}.pdf",method=["LnL", "Bayes"],trait=traits)

rule pre_processed_traits:
    input:
        script=f"{FOLDER}/scripts/pre_processed_traits.py",
        input_dS=lambda wildcards: f"{FOLDER}/data/science.abl8189.Timescale/Table_S2_RootedTrees/Concatenation_HRA_neutral_241_10miss_rooted.tree",
        input_pS=lambda wildcards: f"{FOLDER}/data/science.abn5856.Ne/science.abn5856_table_s1.csv",
        input_traits=f"{FOLDER}/data/expression-datasets/mammals_{{dataset}}_gene_expression_{{trait}}_orthogroups.csv",
        input_orthogroups=f"{FOLDER}/data/one2one_orthogroups.csv",
        input_heritability=f"{FOLDER}/data/heritability-gene-expression/41431_2019_511_MOESM2_ESM.tsv"
    output:
        tree=f"{FOLDER}/data_processed/mammals/{{dataset}}_{{trait}}.tree",
        traits=f"{FOLDER}/data_processed/mammals/{{dataset}}_{{trait}}.traits.tsv",
        var_within=f"{FOLDER}/data_processed/mammals/{{dataset}}_{{trait}}.var_within.tsv"
    log:
        stdout=f"{FOLDER}/data_processed/mammals/{{dataset}}_{{trait}}.preprocessed.log"
    params:
        heritability=lambda wildcards, input, output: f"--input_heritability {input.input_heritability} " if wildcards.trait == "logTPM" else ""
    shell:
        'python3 {input.script} --input_dS {input.input_dS} --input_pS {input.input_pS} '
        '--input_traits {input.input_traits} --input_orthogroups {input.input_orthogroups} {params.heritability}'
        '--output_tree {output.tree} --output_traits {output.traits} --output_var_within {output.var_within} > {log.stdout}'

rule neutrality_index:
    input:
        script=f"{FOLDER}/scripts/neutrality_index.py",
        tree=rules.pre_processed_traits.output.tree,
        traits=rules.pre_processed_traits.output.traits,
        var_within=rules.pre_processed_traits.output.var_within
    output:
        tsv=f"{FOLDER}/data_processed/LnL/{{dataset}}_{{trait}}.tsv"
    log:
        stdout=f"{FOLDER}/data_processed/LnL/{{dataset}}_{{trait}}.processed.log"
    shell:
        'python3 {input.script} --tree {input.tree} --traits {input.traits} --var_within {input.var_within}'
        ' --output {output.tsv} > {log.stdout}'


checkpoint filter_traits:
    input:
        script=f"{FOLDER}/scripts/filter_traits.py",
        tree=rules.pre_processed_traits.output.tree,
        traits=rules.pre_processed_traits.output.traits,
        var_within=rules.pre_processed_traits.output.var_within,
        neutrality_index=rules.neutrality_index.output.tsv
    output:
        dir=directory(f"{FOLDER}/data_processed/filtered/{{dataset}}_{{trait}}"),
    log:
        stdout=f"{FOLDER}/data_processed/filtered/{{dataset}}_{{trait}}.preprocessed.log"
    shell:
        'python3 {input.script} --input_tree {input.tree} --input_traits {input.traits} --input_var_within {input.var_within} --neutrality_index {input.neutrality_index}'
        ' --output_dir {output.dir} > {log.stdout}'


rule run_inference:
    input:
        exec=f"{FOLDER}/utils/BayesCode/bin/nodetraits",
        traits=f"{FOLDER}/data_processed/filtered/{{dataset}}_{{trait}}/{{gene}}.traits.tsv",
        tree=f"{FOLDER}/data_processed/filtered/{{dataset}}_{{trait}}/{{gene}}.tree"
    output:
        run=f"{FOLDER}/data_processed/inference/{{dataset}}_{{trait}}/{{gene}}.run",
    params:
        chain=f"{FOLDER}/data_processed/inference/{{dataset}}_{{trait}}/{{gene}}",
        until=f"--until {UNTIL}",
    log:
        stdout=f"{FOLDER}/data_processed/inference/{{dataset}}_{{trait}}/{{gene}}.log"
    shell:
        '{input.exec} {params.until} --uniq_kappa --df 1 --tree {input.tree} --traitsfile {input.traits} {params.chain} > {log.stdout} '


rule read_trace:
    input:
        exec=f"{FOLDER}/utils/BayesCode/bin/readnodetraits",
        inference=f"{FOLDER}/data_processed/inference/{{dataset}}_{{trait}}/{{gene}}.run",
        var_within=f"{FOLDER}/data_processed/filtered/{{dataset}}_{{trait}}/{{gene}}.var_within.tsv"
    output:
        tsv=f"{FOLDER}/data_processed/Bayes/{{dataset}}_{{trait}}/{{gene}}.tsv",
    params:
        points=f"--burnin {BURN_IN} --until {UNTIL}",
        chain=lambda wildcards: f"{FOLDER}/data_processed/inference/{wildcards.dataset}_{wildcards.trait}/{wildcards.gene}"
    log:
        stdout=f"{FOLDER}/data_processed/Bayes/{{dataset}}_{{trait}}/{{gene}}.trace.log"
    shell:
        '{input.exec} {params.points} --var_within {input.var_within} --output {output.tsv} {params.chain} > {log.stdout} && gzip -f {params.chain}.chain && gzip -f {params.chain}.trace'


def aggregate_input(wildcards):
    checkpoint_output = checkpoints.filter_traits.get(**wildcards).output[0]
    return expand(f"{FOLDER}/data_processed/Bayes/{{dataset}}_{{trait}}/{{gene}}.tsv",dataset=wildcards.dataset,trait=wildcards.trait,gene=glob_wildcards(os.path.join(checkpoint_output,"{gene}.tree")).gene)


rule merge_traces:
    input: aggregate_input
    output:
        tsv=f"{FOLDER}/data_processed/Bayes/{{dataset}}_{{trait}}.tsv",
    params:
        traces=f"{FOLDER}/data_processed/Bayes/{{dataset}}_{{trait}}"
    shell:
        'python3 {FOLDER}/scripts/merge_traces.py --input {params.traces} --output {output.tsv}'


rule merge_results:
    input:
        script=f"{FOLDER}/scripts/merge_results.py",
        tsv_results=expand(f"{FOLDER}/data_processed/{{{{method}}}}/{{dataset}}_{{{{trait}}}}.tsv",dataset=datasets),
    output:
        tsv=f"{FOLDER}/results/{{trait}}/merge_{{method}}.tsv",
    shell:
        'python3 {input.script} --tsv_results {input.tsv_results} --output {output.tsv}'


rule plot_boxplots:
    input:
        script=f"{FOLDER}/scripts/plot_boxplots.py",
        tsv_traits=expand(f"{FOLDER}/data/expression-datasets/mammals_{{dataset}}_gene_expression_{{{{trait}}}}_orthogroups.csv",dataset=datasets),
        tsv_Bayes=f"{FOLDER}/results/{{trait}}/merge_Bayes.tsv",
        input_orthogroups=f"{FOLDER}/data/one2one_orthogroups.csv",
    output:
        tsv=f"{FOLDER}/results/{{trait}}/merged_boxplot_{{trait}}.pdf",
    shell:
        'python3 {input.script} --input_orthogroups {input.input_orthogroups} --tsv_traits {input.tsv_traits} --tsv_Bayes {input.tsv_Bayes} --output {output.tsv}'


rule plot_corr:
    input:
        script=f"{FOLDER}/scripts/plot_corr.py",
        tsv_Bayes=f"{FOLDER}/results/{{trait}}/merge_{{method}}.tsv"
    output:
        tsv=f"{FOLDER}/results/{{trait}}/corr_scatter_{{method}}_{{trait}}.pdf"
    shell:
        'python3 {input.script} --input {input.tsv_Bayes} --output {output.tsv}'
